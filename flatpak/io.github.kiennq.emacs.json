{
  "app-id": "io.github.kiennq.emacs",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "25.08",
  "sdk": "org.freedesktop.Sdk",
  "command": "emacs-wrapper",
  "rename-icon": "emacs",
  "rename-appdata-file": "emacs.metainfo.xml",
  "rename-desktop-file": "emacs.desktop",
  "finish-args": [
    "--share=network",
    "--share=ipc",
    "--socket=pulseaudio",
    "--socket=x11",
    "--socket=ssh-auth",
    "--socket=gpg-agent",
    "--filesystem=host",
    "--filesystem=/tmp",
    "--filesystem=/var/tmp",
    "--talk-name=org.freedesktop.Flatpak"
  ],
  "modules": [
    {
      "name": "tree-sitter",
      "buildsystem": "simple",
      "build-commands": [
        "PREFIX=/app make -j$FLATPAK_BUILDER_N_JOBS",
        "PREFIX=/app make install"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/tree-sitter/tree-sitter.git",
          "tag": "v0.27.0",
          "commit": "6070dbfefd326bd735e5683eb128cc1b57dad0c0"
        }
      ],
      "cleanup": [
        "/include",
        "/lib/pkgconfig",
        "/lib/*.a"
      ]
    },
    {
      "name": "libgccjit",
      "buildsystem": "simple",
      "build-commands": [
        "set -eu; for package in *.deb; do ar p \"$package\" data.tar.zst | tar --zstd -xf -; done",
        "install -Dm644 usr/lib/x86_64-linux-gnu/libgccjit.so.15.0.1 /app/lib/libgccjit.so.15.0.1",
        "ln -s libgccjit.so.15.0.1 /app/lib/libgccjit.so.15",
        "ln -s libgccjit.so.15 /app/lib/libgccjit.so",
        "install -Dm644 usr/lib/gcc/x86_64-linux-gnu/15/include/libgccjit.h /app/include/libgccjit.h",
        "install -Dm755 usr/bin/x86_64-linux-gnu-gcc-15 /app/bin/x86_64-linux-gnu-gcc-15",
        "install -Dm755 usr/libexec/gcc/x86_64-linux-gnu/15/collect2 /app/libexec/gcc/x86_64-linux-gnu/15/collect2",
        "set -eu; for file in crtbeginS.o crtendS.o libgcc.a libgcc_s.so; do install -Dm644 \"usr/lib/gcc/x86_64-linux-gnu/15/$file\" \"/app/lib/gcc/x86_64-linux-gnu/15/$file\"; done",
        "install -Dm644 usr/lib/x86_64-linux-gnu/libisl.so.23.4.0 /app/lib/libisl.so.23.4.0",
        "ln -s libisl.so.23.4.0 /app/lib/libisl.so.23",
        "install -Dm644 usr/lib/x86_64-linux-gnu/libmpc.so.3.3.1 /app/lib/libmpc.so.3.3.1",
        "ln -s libmpc.so.3.3.1 /app/lib/libmpc.so.3",
        "set -eu; for file in crti.o crtn.o libc_nonshared.a; do install -Dm644 \"/usr/lib/x86_64-linux-gnu/$file\" \"/app/lib/gcc/x86_64-linux-gnu/15/$file\"; done",
        "grep -Fq '/usr/lib/x86_64-linux-gnu/libc_nonshared.a' /usr/lib/x86_64-linux-gnu/libc.so && sed 's|/usr/lib/x86_64-linux-gnu/libc_nonshared.a|/app/lib/gcc/x86_64-linux-gnu/15/libc_nonshared.a|' /usr/lib/x86_64-linux-gnu/libc.so > /app/lib/gcc/x86_64-linux-gnu/15/libc.so"
      ],
      "sources": [
        {
          "type": "file",
          "url": "https://snapshot.ubuntu.com/ubuntu/20260922T000000Z/pool/universe/g/gcc-15/libgccjit15_15.2.0-16ubuntu1_amd64.deb",
          "sha256": "ed710f5cb08ad273be165fd21b57eb02ca995bc8259286c2c789b88bc2f353a7"
        },
        {
          "type": "file",
          "url": "https://snapshot.ubuntu.com/ubuntu/20260922T000000Z/pool/universe/g/gcc-15/libgccjit-15-dev_15.2.0-16ubuntu1_amd64.deb",
          "sha256": "f78386f031c1d11f195bd733df1a16d89df4080ffce3294f0e8d3a3c0fc821cf"
        },
        {
          "type": "file",
          "url": "https://snapshot.ubuntu.com/ubuntu/20260922T000000Z/pool/main/g/gcc-15/gcc-15-x86-64-linux-gnu_15.2.0-16ubuntu1_amd64.deb",
          "sha256": "df0e5375c9e981b18e396c2e9ec1e359f226576a9b94a311bf07603f3ca6023a"
        },
        {
          "type": "file",
          "url": "https://snapshot.ubuntu.com/ubuntu/20260922T000000Z/pool/main/g/gcc-15/libgcc-15-dev_15.2.0-16ubuntu1_amd64.deb",
          "sha256": "32fa5bde1891f46fd4f422e466c863fb78e834b634e1aa08211c8eea68870af5"
        },
        {
          "type": "file",
          "url": "https://snapshot.ubuntu.com/ubuntu/20260922T000000Z/pool/main/i/isl/libisl23_0.27-1build1_amd64.deb",
          "sha256": "02ea5de2ab6ddba978606ad58647bf6371ea68c0ed63aa5d6d0d3b8c1fe77ea3"
        },
        {
          "type": "file",
          "url": "https://snapshot.ubuntu.com/ubuntu/20260922T000000Z/pool/main/m/mpclib3/libmpc3_1.3.1-3_amd64.deb",
          "sha256": "a95c75b486f26fe8b140a632fd9e2883b7e2efc21f7586e155d27d2d2ff0ddc0"
        }
      ],
      "cleanup": [
        "/include"
      ]
    },
    {
      "name": "libXmu",
      "buildsystem": "autotools",
      "config-opts": [
        "--disable-static"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://xorg.freedesktop.org/archive/individual/lib/libXmu-1.3.1.tar.xz",
          "sha256": "81a99e94c4501e81c427cbaa4a11748b584933e94b7a156830c3621256857bc4"
        }
      ]
    },
    {
      "name": "libXaw",
      "buildsystem": "autotools",
      "config-opts": [
        "--disable-static"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://xorg.freedesktop.org/archive/individual/lib/libXaw-1.0.16.tar.xz",
          "sha256": "731d572b54c708f81e197a6afa8016918e2e06dfd3025e066ca642a5b8c39c8f"
        }
      ]
    },
    {
      "name": "binutils",
      "buildsystem": "autotools",
      "builddir": true,
      "config-opts": [
        "--disable-binutils",
        "--disable-gdb",
        "--disable-gprofng",
        "--disable-nls",
        "--disable-sim",
        "--disable-werror"
      ],
      "make-args": [
        "all-gas",
        "all-ld"
      ],
      "no-make-install": true,
      "build-commands": [
        "make install-gas install-ld"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://ftp.gnu.org/gnu/binutils/binutils-2.47.tar.xz",
          "sha256": "154ab23b60070e8f27013c22977f1129425d67d1e8acd6e13010e617811e4cff"
        }
      ],
      "cleanup": [
        "/include",
        "/lib/*.a",
        "/lib/*.la",
        "/share/info",
        "/share/man"
      ]
    },
    {
      "name": "emacs",
      "buildsystem": "autotools",
      "config-opts": [
        "--with-mps",
        "--with-native-compilation",
        "--with-tree-sitter",
        "--with-rsvg",
        "--with-x-toolkit=lucid",
        "--without-xwidgets",
        "--with-sound=no",
        "--without-gpm",
        "--without-dbus",
        "--without-pop",
        "--without-mailutils",
        "--without-gsettings"
      ],
      "build-options": {
        "cflags": "-O2 -fno-semantic-interposition -g"
      },
      "sources": [
        {
          "type": "dir",
          "path": "../git/emacs"
        }
      ],
      "post-install": [
        "grep -Fxq 'Exec=emacs %F' /app/share/applications/emacs.desktop && sed -i 's/^Exec=emacs %F$/Exec=emacs-wrapper %F/' /app/share/applications/emacs.desktop"
      ],
      "cleanup": [
        "/include",
        "/lib/systemd",
        "/share/icons/hicolor/scalable/apps/emacs.ico",
        "/share/icons/hicolor/scalable/mimetypes/emacs-document.svg",
        "/share/icons/hicolor/scalable/mimetypes/emacs-document23.svg"
      ]
    },
    {
      "name": "wrapper",
      "buildsystem": "meson",
      "config-opts": [
        "-Deditor_binary=/app/bin/emacs",
        "-Dprogram_name=emacs-wrapper",
        "-Deditor_title=GNU Emacs",
        "-Dflagfile_prefix=flatpak-emacs",
        "-Dfirst_run_template=emacs-first-run.txt"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/flathub-infra/ide-flatpak-wrapper.git",
          "commit": "a9d22d1b36fc8bb814c77d70957715bbc5840f83"
        },
        {
          "type": "file",
          "path": "emacs-first-run.txt"
        }
      ]
    }
  ]
}
