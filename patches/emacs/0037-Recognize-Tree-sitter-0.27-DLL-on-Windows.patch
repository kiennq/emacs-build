From 8767dfdf0e074cd93e50b5c097c4416a6e7fe83d Mon Sep 17 00:00:00 2001
From: Kien Nguyen <kien.n.quang@gmail.com>
Date: Fri, 25 Sep 2026 13:40:33 -0700
Subject: [PATCH] Recognize Tree-sitter 0.27 DLL on Windows

* lisp/term/w32-nt.el (dynamic-library-alist): Try 0.27 first.
---
 lisp/term/w32-nt.el | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/lisp/term/w32-nt.el b/lisp/term/w32-nt.el
index 7a5ae5ed2b5b..565e455b4b38 100644
--- a/lisp/term/w32-nt.el
+++ b/lisp/term/w32-nt.el
@@ -118,7 +118,8 @@ tree-sitter--library-abi
                          "libtree-sitter.dll"
                          "libtree-sitter-0.dll")
          ;; Supported ABI 13..15
-         '(tree-sitter "libtree-sitter-0.26.dll"
+         '(tree-sitter "libtree-sitter-0.27.dll"
+                       "libtree-sitter-0.26.dll"
                        "libtree-sitter-0.25.dll"))))
 
 
-- 
2.55.0.windows.4

